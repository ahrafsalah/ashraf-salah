+              <span className="block font-bold text-white">{item.name}</span>
+              <span className="text-xs text-(--main-color)">
+                {item.role[locale]}
+              </span>
+            </figcaption>
+          </figure>
+        ))}
+      </div>
+    </section>
+  );
+}
